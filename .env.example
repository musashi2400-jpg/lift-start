# ============================================================
# LIFT. START - Environment Variables
# ============================================================
# 
# 本番環境で使用する環境変数テンプレート
# 各項目を実際の値に置き換えてください
# 秘密情報をこのファイルに保存しないでください
#

# ============================================================
# Server Configuration
# ============================================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# ============================================================
# Database (PostgreSQL)
# ============================================================
# 形式: postgresql://username:password@host:port/database
# 例: postgresql://lift:password123@db.railway.app:5432/lift_start
DATABASE_URL=postgresql://user:password@localhost:5432/lift_start

# ============================================================
# Authentication & Security
# ============================================================
# 本番環境では強力なランダム文字列を使用してください
# 例: openssl rand -base64 32
JWT_SECRET=your-production-jwt-secret-change-this
ADMIN_KEY=your-production-admin-key-change-this

# ============================================================
# OpenAI API
# ============================================================
# https://platform.openai.com/account/api-keys で取得
# 形式: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# Stripe (TEST MODE - 本番切り替え時に変更)
# ============================================================
# TEST MODE キー: https://dashboard.stripe.com/test/keys
# LIVE MODE キー: https://dashboard.stripe.com/keys
# 
# TEST MODE (開発・テスト用)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# LIVE MODE (本番用 - 後日切り替え)
# STRIPE_SECRET_KEY=sk_live_your_live_key_here
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_key_here

# Webhook署名キー (Stripe Dashboard → Webhooks から取得)
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================
# Email Configuration (Optional)
# ============================================================
# Gmail の場合:
# 1. 2段階認証を有効化
# 2. https://myaccount.google.com/apppasswords でアプリパスワード生成
# 3. SMTP_PASSWORD に設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# ============================================================
# Legal Information (特商法表記)
# ============================================================
# 本番公開前に実在する情報に変更してください
BUSINESS_NAME=LIFT. START
BUSINESS_ADDRESS=東京都渋谷区
BUSINESS_PHONE=090-xxxx-xxxx
BUSINESS_EMAIL=support@liftstart.jp
BUSINESS_REPRESENTATIVE=代表者名
BUSINESS_REGISTRATION_NUMBER=

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info

# ============================================================
# Optional: Google Maps API (将来の機能用)
# ============================================================
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================================
# Optional: Sentry (エラー追跡)
# ============================================================
# SENTRY_DSN=https://your-sentry-dsn

# ============================================================
# Optional: Analytics
# ============================================================
# ANALYTICS_ENABLED=true
# ANALYTICS_ENDPOINT=https://your-analytics-endpoint
